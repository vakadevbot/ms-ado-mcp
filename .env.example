# Organization URL or Azure DevOps Server collection URL (HTTPS).
AZURE_DEVOPS_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PAT=
# Used as default project. With no rules module, enables read-only access to this project.
AZURE_DEVOPS_PROJECT=Your Project
# Relative to this .env; preferably use an absolute path OUTSIDE the public checkout.
ADO_RULES_FILE=private/rules.py
# "6.1-preview" selects the correct preview revision for each endpoint; "6.1" is also supported.
AZURE_DEVOPS_API_VERSION=6.1-preview
ADO_HTTP_TIMEOUT=30
# Optional PEM bundle for corporate CA; TLS verification always stays enabled.
# ADO_CA_BUNDLE=/absolute/path/company-ca.pem
