# Organization URL or Azure DevOps Server collection URL (HTTPS).
AZURE_DEVOPS_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PAT=
# The PAT owner is the current user (@Me) and the author of all creations.
# No separate user ID is needed; use your personal PAT for your own work items.
# Default project (optional when AZURE_DEVOPS_PROJECTS is set: its first entry is used).
AZURE_DEVOPS_PROJECT=Your Project
# Optional authoritative comma-separated project allowlist. Private rules cannot add
# projects outside this list. Projects without private rules are read-only.
# Example: AZURE_DEVOPS_PROJECTS=Your Project,Another Project
# A comma-separated AZURE_DEVOPS_PROJECT is also accepted when this variable is empty.
AZURE_DEVOPS_PROJECTS=
# Exact Project/Repository pairs, comma-separated; no wildcards. Names, not repository IDs.
# Empty/unset DENIES ALL Git and PR access, even if the PAT has broader permissions.
# Example: ADO_ALLOWED_REPOSITORIES=Your Project/example-repo,Another Project/second-repo
ADO_ALLOWED_REPOSITORIES=
# Relative to this .env; preferably use an absolute path OUTSIDE the public checkout.
ADO_RULES_FILE=private/rules.py
# "6.1-preview" selects the correct preview revision for each endpoint; "6.1" is also supported.
AZURE_DEVOPS_API_VERSION=6.1-preview
ADO_HTTP_TIMEOUT=30
# Optional PEM bundle for corporate CA; TLS verification always stays enabled.
# ADO_CA_BUNDLE=/absolute/path/company-ca.pem

# Additional read tools: PAT Build Read, Release Read, Code Read and project access.
# WIT version above does not control Build/Release/Git API versions; see README.
# Optional HTTPS Release collection URL. Services derive vsrm.dev.azure.com;
# on-premises defaults to AZURE_DEVOPS_URL. No cloud host is required for Server.
# ADO_RELEASE_URL=https://ado.example/collection

# Downloads are disabled when empty. Relative paths resolve against this .env.
# Prefer an absolute directory outside the public checkout; never commit downloads.
ADO_DOWNLOAD_DIR=
ADO_MAX_DOWNLOAD_BYTES=268435456
# Optional comma-separated EXACT trusted HTTPS redirect hostnames (no wildcards).
# Default denies all redirects. Populate locally only for your download infrastructure.
# Redirect requests NEVER carry Authorization or cookies, even to the original host.
ADO_DOWNLOAD_HOSTS=
